{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "bun run site:build",
  "outputDirectory": "site",
  "trailingSlash": true,
  "redirects": [
    {"source": "/prism-os", "destination": "/", "permanent": true},
    {"source": "/prism-os/", "destination": "/", "permanent": true}
  ]
}
