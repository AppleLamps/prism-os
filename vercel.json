{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx -y bun@1.4.3 install",
  "buildCommand": "npx -y bun@1.4.3 scripts/build-demo-site.ts",
  "outputDirectory": "site",
  "trailingSlash": true,
  "redirects": [
    {"source": "/:page(prism-os|demos|os|learned-gallery|json-search)/:rest*", "destination": "/", "permanent": false},
    {"source": "/:page(prism-os|demos|os|learned-gallery|json-search)", "destination": "/", "permanent": false}
  ]
}
