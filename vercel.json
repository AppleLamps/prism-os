{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx -y bun@1.4.3 install",
  "buildCommand": "npx -y bun@1.4.3 scripts/build-demo-site.ts",
  "outputDirectory": "site",
  "trailingSlash": true,
  "redirects": [
    {"source": "/prism-os", "destination": "/", "permanent": true},
    {"source": "/prism-os/", "destination": "/", "permanent": true}
  ]
}
