[
  {
    "type": "function",
    "function": {
      "name": "app",
      "description": "Open, minimize, maximize, restore, close, move or resize an app",
      "parameters": {
        "type": "OBJECT",
        "properties": {
          "action": {
            "type": "STRING",
            "description": "What to do",
            "enum": [
              "open",
              "minimize",
              "maximize",
              "restore",
              "close",
              "move",
              "resize"
            ]
          },
          "app": {
            "type": "STRING",
            "description": "The app",
            "enum": [
              "scope",
              "inkwell",
              "chroma",
              "cabinet",
              "browser",
              "calculator",
              "clock",
              "terminal",
              "settings",
              "about"
            ]
          },
          "position": {
            "type": "STRING",
            "description": "Where to move it",
            "enum": [
              "left",
              "right",
              "center",
              "top_left",
              "top_right",
              "bottom_left",
              "bottom_right"
            ]
          },
          "size": {
            "type": "STRING",
            "description": "The new size, for scope, inkwell or chroma",
            "enum": [
              "small",
              "medium",
              "large",
              "bigger",
              "smaller"
            ]
          }
        },
        "required": [
          "action",
          "app"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "layout",
      "description": "Arrange the windows",
      "parameters": {
        "type": "OBJECT",
        "properties": {
          "action": {
            "type": "STRING",
            "description": "side_by_side puts two program windows on halves of the screen, show_desktop minimizes every window, reset puts the program windows back",
            "enum": [
              "side_by_side",
              "show_desktop",
              "reset"
            ]
          },
          "left": {
            "type": "STRING",
            "description": "The window on the left",
            "enum": [
              "scope",
              "inkwell",
              "chroma"
            ]
          },
          "right": {
            "type": "STRING",
            "description": "The window on the right",
            "enum": [
              "scope",
              "inkwell",
              "chroma"
            ]
          }
        },
        "required": [
          "action"
        ]
      }
    }
  },
  {
