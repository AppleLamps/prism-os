// Run against a fresh local browser profile with:
// npx --package @playwright/cli playwright-cli -s=cabinet run-code --filename tests/prismos/cabinet.pwcode
async page => {
  const errors = []
  const waitFor = predicate => page.waitForFunction(predicate, null, {timeout: 10000}).catch(error => { throw new Error(`Waiting for ${predicate.toString()}: ${error.message}`) })
  page.on('pageerror', error => errors.push(error.message))
  const assert = (condition, text) => { if (!condition) throw new Error(text) }
  const command = async (text, keepOpen = false) => {
    await page.keyboard.press('Control+k')
    const input = page.getByRole('searchbox', {name: 'Search or command'})
    await input.fill(text); await input.press('Enter')
    await waitFor(() => !document.querySelector('.spotlight-commands')?.classList.contains('is-busy'))
    const failures = page.locator('.spotlight-reply.is-error')
    const failure = await failures.count() > 0 ? await failures.last().textContent() : null
    if (failure) throw new Error(failure)
    if (!keepOpen) await page.keyboard.press('Escape')
  }
  const openCabinet = async () => {
    await page.getByRole('button', {name: 'Cabinet', exact: true}).click()
    await page.getByRole('dialog', {name: 'Cabinet', exact: true}).getByRole('button', {name: 'Import', exact: true}).waitFor()
    await waitFor(() => Number(document.querySelector('.prism-panel-cabinet')?.style.zIndex) >= 20)
  }
  await page.setViewportSize({width: 1440, height: 960})
  await page.emulateMedia({colorScheme: 'light'})
  await page.goto('http://127.0.0.1:3000/')
  // This script uses the dedicated cabinet browser session, never a personal profile.
  await waitFor(() => document.querySelector('.inkwell-files [role=status]')?.textContent === 'Saved')
  await page.evaluate(async () => {
    const opening = indexedDB.open('prism-os.files', 1)
    const db = await new Promise(resolve => { opening.onsuccess = () => resolve(opening.result) })
    const tx = db.transaction(['entries', 'blobs', 'flags'], 'readwrite')
    for (const name of ['entries', 'blobs', 'flags']) tx.objectStore(name).clear()
    await new Promise((resolve, reject) => { tx.oncomplete = resolve; tx.onabort = () => reject(tx.error) }); db.close()
  })
  await page.reload()
  await openCabinet()
  const cabinet = page.getByRole('dialog', {name: 'Cabinet', exact: true})
  await cabinet.getByRole('navigation', {name: 'Cabinet locations'}).getByRole('button', {name: 'Documents', exact: true}).click()
  const payloads = [{name: 'Cabinet Acceptance.txt', mimeType: 'text/plain', buffer: Buffer.from('imported bytes\r\n')}, {name: 'bytes.bin', mimeType: 'application/octet-stream', buffer: Buffer.from([0,255,128,13,10])}]
  await cabinet.locator('input[type=file]').setInputFiles(payloads)
  await cabinet.getByRole('option', {name: 'Cabinet Acceptance.txt', exact: true}).waitFor()
  await cabinet.getByRole('option', {name: 'Cabinet Acceptance.txt', exact: true}).dblclick()
  const note = page.getByRole('textbox', {name: 'Note', exact: true})
  await note.fill('saved by Inkwell\nsecond line')
  await waitFor(() => document.querySelector('.inkwell-files [role=status]')?.textContent === 'Saved')
  const readFiles = async () => page.evaluate(async () => {
    const opening = indexedDB.open('prism-os.files', 1)
    const db = await new Promise((resolve, reject) => { opening.onsuccess = () => resolve(opening.result); opening.onerror = () => reject(opening.error) })
    const tx = db.transaction(['entries', 'blobs'])
    const request = tx.objectStore('entries').getAll()
    const entries = await new Promise(resolve => { request.onsuccess = () => resolve(request.result) })
    db.close()
    return entries
  })
  let files = await readFiles()
  const imported = files.find(entry => entry.name === 'Cabinet Acceptance.txt')
  assert(imported?.revision === 2, 'Inkwell did not commit its edit')
  await page.reload()
  await openCabinet()
  await cabinet.getByRole('navigation', {name: 'Cabinet locations'}).getByRole('button', {name: 'Documents', exact: true}).click()
  await cabinet.getByRole('option', {name: 'Cabinet Acceptance.txt', exact: true}).dblclick()
  await waitFor(() => document.querySelector('.notes-text')?.value === 'saved by Inkwell\nsecond line')
  await openCabinet()
  await cabinet.getByRole('option', {name: 'Cabinet Acceptance.txt', exact: true}).click()
  await cabinet.getByRole('button', {name: 'Duplicate', exact: true}).click()
  await cabinet.getByRole('option', {name: 'Cabinet Acceptance (2).txt', exact: true}).waitFor()
  await cabinet.getByRole('option', {name: 'Cabinet Acceptance (2).txt', exact: true}).click()
  await cabinet.getByRole('button', {name: 'Rename', exact: true}).click()
  await page.getByRole('textbox', {name: 'Rename item', exact: true}).fill('Renamed.txt')
  await page.getByRole('dialog', {name: 'Rename item', exact: true}).getByRole('button', {name: 'OK', exact: true}).click()
  await cabinet.getByRole('option', {name: 'Renamed.txt', exact: true}).click()
  await cabinet.locator('.cabinet-actions').getByRole('button', {name: 'Trash', exact: true}).click()
  await cabinet.getByRole('navigation', {name: 'Cabinet locations'}).getByRole('button', {name: 'Trash', exact: true}).click()
  await cabinet.getByRole('option', {name: 'Renamed.txt', exact: true}).click()
  await cabinet.getByRole('button', {name: 'Restore', exact: true}).click()
  await cabinet.getByRole('navigation', {name: 'Cabinet locations'}).getByRole('button', {name: 'Documents', exact: true}).click()
  await cabinet.getByRole('option', {name: 'Renamed.txt', exact: true}).waitFor()
  await cabinet.getByRole('option', {name: 'bytes.bin', exact: true}).click()
  const downloadPromise = page.waitForEvent('download')
  await cabinet.getByRole('button', {name: 'Download', exact: true}).click()
  const download = await downloadPromise
  await page.bringToFront()
  assert(download.suggestedFilename() === 'bytes.bin', 'Download name changed')
  const stream = await download.createReadStream(), chunks = []
  for await (const chunk of stream) chunks.push(chunk)
  assert(Buffer.concat(chunks).equals(Buffer.from([0,255,128,13,10])), 'Downloaded bytes changed')
  await cabinet.getByRole('navigation', {name: 'Cabinet locations'}).getByRole('button', {name: 'Pictures', exact: true}).click()
  const png = Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jF1kAAAAASUVORK5CYII=', 'base64')
  await cabinet.locator('input[type=file]').setInputFiles(Array.from({length: 25}, (_, i) => ({name: `Image ${String(i + 1).padStart(2, '0')}.png`, mimeType: 'image/png', buffer: png})))
  await waitFor(() => document.querySelector('.cabinet-status')?.textContent.includes('Imported 25/25'))
  await cabinet.getByRole('option', {name: 'Image 25.png', exact: true}).waitFor()
  await cabinet.getByRole('option', {name: 'Image 12.png', exact: true}).dblclick()
  await waitFor(() => document.querySelector('.cabinet-gallery-toolbar')?.textContent.includes('1/3'))
  await waitFor(() => document.querySelectorAll('.window')[2]?.style.getPropertyValue('--focused') === '1')
  await page.keyboard.press('ArrowRight')
  await waitFor(() => document.querySelector('.cabinet-gallery-toolbar')?.textContent.includes('2/3'))
  await page.keyboard.press('ArrowLeft')
  await waitFor(() => document.querySelector('.cabinet-gallery-toolbar')?.textContent.includes('1/3'))
  const arrow = await page.locator('.photos-next').boundingBox()
  await page.mouse.click(arrow.x + arrow.width / 2, arrow.y + arrow.height / 2)
  await waitFor(() => document.querySelector('.cabinet-gallery-toolbar')?.textContent.includes('2/3'))
  const backArrow = await page.locator('.photos-previous').boundingBox()
  await page.mouse.click(backArrow.x + backArrow.width / 2, backArrow.y + backArrow.height / 2)
  await waitFor(() => document.querySelector('.cabinet-gallery-toolbar')?.textContent.includes('1/3'))
  await command('open photo Image 25.png')
  await waitFor(() => document.querySelector('.cabinet-gallery-toolbar')?.textContent.includes('3/3'))
  await page.keyboard.press('ArrowRight')
  await waitFor(() => document.querySelector('.cabinet-gallery-toolbar')?.textContent.includes('1/3'))
  await command('start the slideshow', true)
  await waitFor(() => Array.from(document.querySelectorAll('.photos-photo')).some(element => element.textContent === 'Image 03.png'))
  await page.keyboard.press('Escape')
  await command('stop the slideshow')
  await page.getByRole('button', {name: 'Bundled gallery', exact: true}).click()
  await waitFor(() => document.querySelector('.cabinet-gallery-toolbar')?.hidden === true)
  await command('create folder /Documents/Command Folder')
  files = await readFiles()
  assert(files.some(entry => entry.name === 'Command Folder'), 'Spotlight did not create folder')
  await openCabinet()
  await page.screenshot({path: 'output/playwright/cabinet-desktop.png'})
  await page.emulateMedia({colorScheme: 'dark'})
  await page.screenshot({path: 'output/playwright/cabinet-dark.png'})
  await page.setViewportSize({width: 390, height: 844})
  await waitFor(() => document.querySelector('.prism-panel-cabinet')?.getBoundingClientRect().right <= 390)
  await command('open cabinet')
  await waitFor(() => Number(document.querySelector('.prism-panel-cabinet')?.style.zIndex) >= 20)
  await waitFor(() => document.elementFromPoint(170, 350)?.closest('.prism-panel-cabinet') !== null)
  await page.screenshot({path: 'output/playwright/cabinet-mobile.png'})
  assert(await page.getByRole('button', {name: 'Cabinet', exact: true}).isHidden(), 'Extra dock tile should be hidden on mobile')
  assert(errors.length === 0, errors.join('\n'))
  console.log('PASS: import, edit, reload, duplicate, rename, Trash, restore, binary download, 25-image navigation, commands, desktop/dark/mobile')
}
